<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container GRASP shares with its desktop widgets. Team-prefixed,
	     so it needs no provisioning profile; the app itself stays
	     unsandboxed. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>L6PBP46NZU.com.tyvillan.grasp</string>
	</array>
</dict>
</plist>
