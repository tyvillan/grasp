<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>GRASP</string>
    <key>CFBundleDisplayName</key>
    <string>GRASP</string>
    <key>CFBundleIdentifier</key>
    <string>com.tyvillan.grasp</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>GRASP</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Both keys: macOS 14 split calendar access into full/write-only,
         and the older key is still what pre-14 systems read. GRASP only
         ever reads (it never writes to Calendar.app), but reading exam
         dates is exactly what the "full access" prompt gates. -->
    <key>NSCalendarsUsageDescription</key>
    <string>GRASP reads your calendar to find exam and quiz dates and match them to your courses. It never adds, changes, or deletes anything in your calendar.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>GRASP reads your calendar to find exam and quiz dates and match them to your courses. It never adds, changes, or deletes anything in your calendar.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Tyler Villanueva</string>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.tyvillan.grasp.card</string>
            <key>UTTypeDescription</key>
            <string>GRASP Card</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
